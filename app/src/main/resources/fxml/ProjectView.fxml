<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unibo.taskhive.controllers.ProjectViewController">
   <left>
      <VBox styleClass="sidebar" prefWidth="300.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" fillHeight="true">
               <children>
                  <ImageView fitHeight="40.0" preserveRatio="true" pickOnBounds="true">
                     <image>
                        <Image url="@/img/taskhive_logo.png" />
                     </image>
                  </ImageView>
                  <!--<Label styleClass="sidebar-title" text="TaskHive" />-->
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Button fx:id="notificationButton" styleClass="notification-button" text="🔔" />
                        <Button fx:id="logoutButton" styleClass="logout-button" text="⏻" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <ListView fx:id="projectListView" styleClass="project-list" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </ListView>
            <VBox styleClass="sidebar-buttons" spacing="10.0">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="addProjectButton" styleClass="primary-button" text="Create Project" maxWidth="Infinity" />
                  <Button fx:id="editProjectButton" styleClass="secondary-button" text="Edit Project" maxWidth="Infinity" />
                  <Button fx:id="deleteProjectButton" styleClass="danger-button" text="Delete Project" maxWidth="Infinity" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox styleClass="main-content">
         <children>
            <VBox styleClass="header" spacing="5.0">
               <padding>
                  <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <Label fx:id="projectTitleLabel" styleClass="project-title" text="Use the sidebar to select a project or create a new one" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addTaskButton" styleClass="primary-button" text="+ Add Task" />
                     </children>
                  </HBox>
                  <Label fx:id="projectDescriptionLabel" styleClass="project-description" text="" wrapText="true" />
               </children>
            </VBox>
            <ScrollPane styleClass="kanban-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
               <content>
                  <HBox fx:id="kanbanBoard" styleClass="kanban-board" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane> 
